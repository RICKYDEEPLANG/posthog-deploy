# PostHog AWS 部署配置模板
# 复制此文件为 .env 并填写实际值

# 安全密钥（必须修改）
POSTHOG_SECRET=<生成一个随机字符串>
ENCRYPTION_SALT_KEYS=<生成一个随机字符串>

# 域名配置
DOMAIN=your-domain.com
CADDY_HOST="your-domain.com, http://, https://"
TLS_BLOCK=
CADDY_TLS_BLOCK=

# PostHog 镜像（AWS 用官方源）
REGISTRY_URL=ghcr.io/posthog/posthog
POSTHOG_APP_TAG=latest

# AI API（可选）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 邮件配置（可选）
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=PostHog <noreply@example.com>
EMAIL_ENABLED=false

# 飞书登录（可选）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
